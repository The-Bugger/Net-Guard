# NetGuard IDPS — Environment Variables
# =====================================================================
# Copy this file to .env and fill in values for your environment:
#   cp .env.example .env
#
# Never commit .env to version control.
# Variables here are loaded by python-dotenv at startup (main.py).
# =====================================================================


# ── Flask ──────────────────────────────────────────────────────────────────

# Flask execution environment.
# Type: string
# Values: development | production | testing
# Default: development
FLASK_ENV=development

# Python import path for the Flask application module.
# Type: string
# Default: backend/main.py
FLASK_APP=backend/main.py

# IP address Flask binds to.
# Use 0.0.0.0 to accept connections on all interfaces (typical for servers).
# Use 127.0.0.1 to restrict to localhost only.
# Type: string (IPv4 address)
# Default: 0.0.0.0
FLASK_HOST=0.0.0.0

# TCP port Flask listens on.
# Type: integer (1–65535)
# Default: 5000
FLASK_PORT=5000


# ── Security ───────────────────────────────────────────────────────────────

# Flask SECRET_KEY used to sign session cookies.
# CHANGE THIS before any production or public deployment.
# Type: string (minimum 32 random characters recommended)
# Default: change-me-before-production
# Example: openssl rand -hex 32
SECRET_KEY=change-me-before-production


# ── Database ───────────────────────────────────────────────────────────────

# SQLAlchemy database URL.
# SQLite (default, relative to project root):
#   sqlite:///database/netguard.db
# SQLite (absolute path):
#   sqlite:////home/user/netguard/database/netguard.db
# Type: string (SQLAlchemy URL)
# Default: sqlite:///database/netguard.db
DATABASE_URL=sqlite:///database/netguard.db


# ── Logging ────────────────────────────────────────────────────────────────

# Python logging level for the netguard root logger.
# Type: string
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: INFO
# Note: DEBUG produces verbose output including per-packet debug lines.
LOG_LEVEL=INFO
